<!-- FIPinator 3000 - FREE and open source (AGPL-3.0). Free to use, change, share and fork. https://github.com/Pribilof-Hangar/fipinator-3000 -->
<UserControl x:Class="Fipinator.GaugeMaker.EditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Fipinator.GaugeMaker"
             Focusable="True">
    <Grid Margin="20,14,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- Top bar -->
        <DockPanel Grid.ColumnSpan="5" Margin="0,0,0,10" LastChildFill="True">
            <Button x:Name="Back" DockPanel.Dock="Left" Margin="0,0,14,0" ToolTip="Back to the start screen">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock Text="Home" /></StackPanel>
            </Button>
            <Button x:Name="Save" DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource AccentButtonStyle}" ToolTip="Save (Ctrl+S)">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock x:Name="SaveText" Text="Save" /></StackPanel>
            </Button>
            <Button x:Name="TextEditor" DockPanel.Dock="Right" Margin="8,0,0,0" Content="Open in text editor" />
            <ToggleButton x:Name="Extremes" DockPanel.Dock="Right" Margin="8,0,0,0" Content="Show extremes" />
            <ComboBox x:Name="Zoom" DockPanel.Dock="Right" Width="76" SelectedIndex="1" Margin="8,0,0,0" ToolTip="Picture size">
                <ComboBoxItem Content="1x" />
                <ComboBoxItem Content="2x" />
                <ComboBoxItem Content="3x" />
            </ComboBox>
            <Button x:Name="Redo" DockPanel.Dock="Right" Margin="8,0,0,0" ToolTip="Redo (Ctrl+Y)">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBlock Text="Redo" /></StackPanel>
            </Button>
            <Button x:Name="Undo" DockPanel.Dock="Right" Margin="8,0,0,0" ToolTip="Undo (Ctrl+Z)">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBlock Text="Undo" /></StackPanel>
            </Button>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="GaugeName" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="FilePath" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>

        <!-- One-line messages: built-in gauge, file changed outside, saved... -->
        <Border x:Name="Bar" Grid.Row="1" Grid.ColumnSpan="5" Visibility="Collapsed" CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}">
            <DockPanel>
                <Button x:Name="BarButton2" DockPanel.Dock="Right" Margin="8,0,0,0" Visibility="Collapsed" />
                <Button x:Name="BarButton" DockPanel.Dock="Right" Margin="8,0,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="BarText" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Left: the gauge's parts -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Parts" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,8" Text="Click a part here or on the gauge. Drag on the gauge to move it." />
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button x:Name="Add" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock Text="Add part" /></StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="AddNumberBox" Header="Number box (shows a value as digits)" />
                                <MenuItem x:Name="AddNeedle" Header="Needle" />
                                <MenuItem x:Name="AddGreenArc" Header="Green arc (normal range)" />
                                <MenuItem x:Name="AddYellowArc" Header="Yellow arc (caution)" />
                                <MenuItem x:Name="AddRedArc" Header="Red line or arc (limit)" />
                                <MenuItem x:Name="AddTextItem" Header="Text" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <UniformGrid Columns="4" Margin="0,6,0,0">
                        <Button x:Name="CopyPart" Margin="0,0,3,0" ToolTip="Make a copy of this part"><TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" /></Button>
                        <Button x:Name="Forward" Margin="3,0,3,0" ToolTip="Draw this part on top of the next one"><TextBlock Text="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" /></Button>
                        <Button x:Name="Backward" Margin="3,0,3,0" ToolTip="Draw this part behind the one before"><TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" /></Button>
                        <Button x:Name="RemovePart" Margin="3,0,0,0" ToolTip="Remove this part (Delete)"><TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" /></Button>
                    </UniformGrid>
                    <StackPanel x:Name="EngineSection">
                        <TextBlock Text="Engine needles" FontWeight="SemiBold" Margin="0,14,0,4" />
                        <UniformGrid x:Name="NeedleCount" Columns="4">
                            <Button Content="1" Tag="1" Margin="0,0,3,0" />
                            <Button Content="2" Tag="2" Margin="3,0,3,0" />
                            <Button Content="3" Tag="3" Margin="3,0,3,0" />
                            <Button Content="4" Tag="4" Margin="3,0,0,0" />
                        </UniformGrid>
                        <TextBlock x:Name="NeedleHint" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel x:Name="RmiSection" Visibility="Collapsed">
                        <TextBlock Text="Needles pointing to" FontWeight="SemiBold" Margin="0,14,0,4" />
                        <UniformGrid x:Name="RmiNeedles" Columns="2">
                            <CheckBox Content="VOR 1" Tag="Vor1" Margin="0,0,0,2" />
                            <CheckBox Content="ADF 1" Tag="Adf1" Margin="0,0,0,2" />
                            <CheckBox Content="VOR 2" Tag="Vor2" />
                            <CheckBox Content="ADF 2" Tag="Adf2" />
                        </UniformGrid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="Tick to add a needle (with its key in a corner), untick to remove it." />
                    </StackPanel>
                </StackPanel>
                <ListBox x:Name="PartsList" />
            </DockPanel>
        </Border>

        <!-- Middle: the gauge -->
        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" Padding="12">
            <DockPanel>
                <local:ReferencePicture x:Name="RefPicture" DockPanel.Dock="Bottom" Margin="0,12,0,0" />
                <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
                    <TextBlock Text="Look" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox x:Name="Look" Width="230" SelectedIndex="0" VerticalAlignment="Center" ToolTip="Give the whole gauge another case and colours (Undo goes back)">
                        <ComboBoxItem Content="Pick a look..." />
                        <ComboBoxItem Content="Classic grey" Tag="Classic" />
                        <ComboBoxItem Content="Black (Cessna style)" Tag="Black" />
                        <ComboBoxItem Content="DC-6 dark" Tag="Dc6" />
                        <ComboBoxItem Content="Light grey (twin style)" Tag="LightTwin" />
                        <ComboBoxItem Content="727 (old Boeing, grey-green)" Tag="Boeing727" />
                        <ComboBoxItem Content="737 Classic (-300/-400/-500, tan)" Tag="Boeing737Classic" />
                    </ComboBox>
                    <TextBlock Text="Background" FontWeight="SemiBold" VerticalAlignment="Center" Margin="20,0,10,0" />
                    <ContentControl x:Name="BackgroundSlot" VerticalAlignment="Center" />
                </DockPanel>
                <Border Background="#202224" CornerRadius="4">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <!-- The gauge, the see-through reference picture, and the outline of the picked part. -->
                        <Grid x:Name="Stage" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" Cursor="Hand">
                            <Image x:Name="Preview" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <Image x:Name="Reference" Visibility="Collapsed" IsHitTestVisible="False"
                                   Width="{Binding ActualWidth, ElementName=Preview}" Height="{Binding ActualHeight, ElementName=Preview}" />
                            <Canvas x:Name="Overlay" IsHitTestVisible="False">
                                <Rectangle x:Name="Picked" Stroke="#4CC2FF" StrokeThickness="1.5" StrokeDashArray="4 3" Visibility="Collapsed" />
                            </Canvas>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Border>

        <!-- Right: settings of the picked part, try it, checks -->
        <Grid Grid.Row="2" Grid.Column="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="5*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="3*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="14">
                <DockPanel>
                    <TextBlock x:Name="SettingsTitle" DockPanel.Dock="Top" Text="Settings" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" TextTrimming="CharacterEllipsis" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SettingsPanel" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button x:Name="Reset" Content="Reset" DockPanel.Dock="Right" />
                        <TextBlock Text="Try it" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="Values" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Checks" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="Checks" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
