<!-- FIPinator 3000 - FREE and open source (AGPL-3.0). Free to use, change, share and fork. https://github.com/Pribilof-Hangar/fipinator-3000 -->
<UserControl x:Class="Fipinator.GaugeMaker.ReferencePicture"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A picture to line the gauge up with: a sim snapshot or any picture. Only a guide on this PC:
         it's kept in memory, never saved into a gauge and never shared. -->
    <StackPanel>
        <TextBlock Text="Reference picture" FontWeight="SemiBold" Margin="0,0,0,4" />
        <WrapPanel>
            <Button x:Name="Snapshot" Margin="0,0,6,6" ToolTip="FIPinator 3000 gets out of the way for 3 seconds and takes a picture of the sim's window. Point the sim's camera at the gauge first.">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE722;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBlock Text="Snapshot of the sim" /></StackPanel>
            </Button>
            <Button x:Name="Open" Margin="0,0,6,6" ToolTip="Any picture on this PC: your own screenshot, a photo of a real instrument...">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8E5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBlock Text="Open picture..." /></StackPanel>
            </Button>
            <Button x:Name="Clear" Content="Clear" Margin="0,0,6,6" IsEnabled="False" />
        </WrapPanel>
        <DockPanel x:Name="SeeThroughRow" IsEnabled="False">
            <TextBlock Text="See-through" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Button x:Name="ResetFit" Content="Fit" DockPanel.Dock="Right" Margin="8,0,0,0" ToolTip="Back to the whole picture, centred" />
            <Slider x:Name="Fade" Minimum="0.1" Maximum="0.9" Value="0.45" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock x:Name="Status" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="Drag the picture to move it, scroll to zoom. It's only a guide on this PC: never saved into the gauge or shared." />
    </StackPanel>
</UserControl>
