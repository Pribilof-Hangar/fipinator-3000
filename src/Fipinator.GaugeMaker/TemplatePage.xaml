<!-- FIPinator 3000 - FREE and open source (AGPL-3.0). Free to use, change, share and fork. https://github.com/Pribilof-Hangar/fipinator-3000 -->
<UserControl x:Class="Fipinator.GaugeMaker.TemplatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- "Change how a gauge looks": one list of the user's own gauges and the ready-made ones. Own gauges open
         straight in the editor; a ready-made one is copied first (named by the user), the original stays. -->
    <Grid Margin="40,24,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Change how a gauge looks" FontSize="24" FontWeight="SemiBold" Grid.ColumnSpan="3" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Hint}" Margin="0,4,0,14" FontSize="14" TextWrapping="Wrap"
                   Text="Pick one of your own gauges, or a ready-made one (you get your own copy; the ready-made one stays as it is). Then: Quick colours to just change colours, or the Full editor for everything else." />

        <DockPanel Grid.Row="2" Margin="0,0,0,6">
            <Button x:Name="OpenFile" DockPanel.Dock="Right" Content="Open from a file..." Margin="8,0,0,0" />
            <TextBox x:Name="Search" ToolTip="Type part of a name or group, e.g. airspeed, DC-6, 727" />
        </DockPanel>
        <ListBox x:Name="List" Grid.Row="3" Grid.Column="0" DisplayMemberPath="Text" />

        <Border Grid.Row="2" Grid.RowSpan="2" Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel Width="480">
                <Image x:Name="Preview" Width="480" Height="360" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <TextBlock x:Name="Description" Style="{StaticResource Hint}" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Grid.ColumnSpan="3" Style="{StaticResource Card}" Margin="0,18,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel x:Name="NameRow" Orientation="Horizontal">
                    <TextBlock Text="Name your copy" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,14,0" />
                    <TextBox x:Name="NameBox" Width="280" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="Error" Foreground="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                <Button x:Name="Create" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="14,6" HorizontalContentAlignment="Left">
                    <StackPanel>
                        <TextBlock Text="Full editor" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Hint}" FontSize="11" Text="Everything: move parts, needles, number boxes, arcs" />
                    </StackPanel>
                </Button>
                <Button x:Name="Quick" DockPanel.Dock="Right" Style="{StaticResource AccentButtonStyle}" Margin="8,0,0,0" Padding="14,6" HorizontalContentAlignment="Left">
                    <StackPanel>
                        <TextBlock Text="Quick colours" FontWeight="SemiBold" />
                        <TextBlock FontSize="11" Opacity="0.85" Text="Just change background, dial, numbers, needles" />
                    </StackPanel>
                </Button>
                <Button x:Name="Back" DockPanel.Dock="Right" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock Text="Home" /></StackPanel></Button>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
