<!-- FIPinator 3000 - FREE and open source (AGPL-3.0). Free to use, change, share and fork. https://github.com/Pribilof-Hangar/fipinator-3000 -->
<Application x:Class="Fipinator.GaugeMaker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Dark">
    <Application.Resources>
        <!-- "Cockpit dark" look (owner's pick, 2026-11-14): panel greys like an instrument panel at night, amber
             highlights. These override the Windows dark theme's own colours. -->
        <Color x:Key="CockpitPanel">#1B1E21</Color>
        <Color x:Key="CockpitCard">#262A2E</Color>
        <Color x:Key="CockpitEdge">#3A4046</Color>
        <Color x:Key="CockpitAmber">#F2A03D</Color>
        <Color x:Key="SystemAccentColor">#F2A03D</Color>
        <Color x:Key="SystemAccentColorLight1">#F5B25E</Color>
        <Color x:Key="SystemAccentColorLight2">#F2A03D</Color>
        <Color x:Key="SystemAccentColorLight3">#F7C584</Color>
        <Color x:Key="SystemAccentColorDark1">#D98A2B</Color>
        <SolidColorBrush x:Key="CockpitPanelBrush" Color="#1B1E21" />
        <SolidColorBrush x:Key="CockpitCardBrush" Color="#262A2E" />
        <SolidColorBrush x:Key="CockpitEdgeBrush" Color="#3A4046" />
        <SolidColorBrush x:Key="CockpitAmberBrush" Color="#F2A03D" />
        <SolidColorBrush x:Key="CockpitTextBrush" Color="#E8E5DC" />
        <SolidColorBrush x:Key="CockpitMutedBrush" Color="#A9A59B" />
        <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#1B1E21" />
        <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#1B1E21" />
        <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#262A2E" />
        <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#3A4046" />
        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#F2A03D" />
        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#F5B25E" />
        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#D98A2B" />
        <!-- The accent buttons (Save, Quick colours...) use their own keys in the Windows theme: amber too. -->
        <SolidColorBrush x:Key="AccentButtonBackground" Color="#F2A03D" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#F5B25E" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#D98A2B" />
        <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#3A4046" />
        <SolidColorBrush x:Key="AccentButtonForeground" Color="#1B1E21" />
        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#1B1E21" />
        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#1B1E21" />
        <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#A9A59B" />
        <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#F2A03D" />
        <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#F5B25E" />
        <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#D98A2B" />
        <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#1B1E21" />
        <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#2B2F33" />
        <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E8E5DC" />
        <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#A9A59B" />
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Application.Resources>
</Application>
